{
    "runtime.version": "Lua 5.1",
    "runtime.nonstandardSymbol": [
        "continue",
        "+=",
        "-=",
        "*=",
        "/=",
        "//=",
        "%=",
        "^=",
        "`"
    ],
    "runtime.builtin": {
        "basic": "disable",
        "bit": "disable",
        "bit32": "disable",
        "coroutine": "disable",
        "debug": "disable",
        "ffi": "disable",
        "io": "disable",
        "jit": "disable",
        "jit.profile": "disable",
        "jit.util": "disable",
        "math": "disable",
        "os": "disable",
        "package": "disable",
        "string": "disable",
        "string.buffer": "disable",
        "table": "disable",
        "table.clear": "disable",
        "table.new": "disable",
        "utf8": "disable"
    },
    "workspace.maxPreload": 10000
}